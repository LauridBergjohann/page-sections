{
  "format": "timeline-layout-fixtures",
  "formatVersion": 1,
  "notASection": true,
  "description": "Synthetic edge cases for the timeline rebuild. This is an independent test contract, not directly renderable TimelineSection JSON. All names and events are invented.",
  "referenceDate": "2026-11-25",
  "conventions": {
    "laneZero": "Lane 0 is closest to the time axis; top/bottom does not change this meaning.",
    "priorityOrder": [
      "category priorityIndex ascending",
      "actual event duration descending; point duration = 0",
      "normalized start/date ascending",
      "stable event identity (categoryId,eventId) in code-point order"
    ],
    "clusterPriority": "Use the category shared by all members. Duration priority is the longest actual member duration, not the time span covered by the group.",
    "listChronology": "Use point.date or period.start. Descending means newest first; ascending means oldest first. Resolve ties by stable ID.",
    "geometry": "CSS-pixel values and thresholds in individual cases are isolated test-adapter inputs, not a prescribed public API. Visible markers and required spacing count towards collisions.",
    "datePrecision": "Preserve YYYY, YYYY-MM and YYYY-MM-DD separately; do not invent month or day values in labels.",
    "scope": "Codex should translate these cases into the repository's existing test structure. The assertions are declarative and are not executed by this JSON file itself. All fixture content is English and uses en-GB date formatting; no language-switching adapter is required.",
    "state": "Test hysteresis deterministically using both the same input and the same previous cluster state.",
    "clustering": "Cluster within each category before assigning shared lanes. Do not force long bars into clusters. A global height target is soft.",
    "eventIdentity": "Identity is the pair (categoryId,eventId). Event IDs only need to be unique within their category. A bare eventId in an assertion is shorthand only when it is unambiguous within that case.",
    "dateIntervals": "Preserve the existing semantics: period.start is inclusive and period.end is exclusive. A point internally reserves one day for temporal collision checks; its actual duration and duration priority remain 0. Check visible glyphs and spacing separately.",
    "ongoingEndPrecedence": "Resolve a missing period.end using the existing precedence: Section.end, otherwise referenceDate, otherwise a shared SSR/hydration date. A harness projection domain does not automatically become Section.end."
  },
  "fixtures": [
    {
      "id": "strict-priority-chain",
      "purpose": "Strict overlap priority without category bands; three lanes despite only two concurrent events.",
      "input": {
        "categories": [
          {
            "id": "programme",
            "priorityIndex": 0
          },
          {
            "id": "projects",
            "priorityIndex": 1
          },
          {
            "id": "publications",
            "priorityIndex": 2
          },
          {
            "id": "research",
            "priorityIndex": 3
          }
        ],
        "clusteringEnabled": false,
        "events": [
          {
            "id": "a",
            "categoryId": "programme",
            "type": "period",
            "start": "2010-01-01",
            "title": "a",
            "end": "2015-01-01"
          },
          {
            "id": "b",
            "categoryId": "programme",
            "type": "period",
            "start": "2014-01-01",
            "title": "b",
            "end": "2018-01-01"
          },
          {
            "id": "c",
            "categoryId": "projects",
            "type": "period",
            "start": "2016-01-01",
            "title": "c",
            "end": "2017-01-01"
          }
        ]
      },
      "expectedRelations": [
        {
          "assert": "laneEquals",
          "eventId": "a",
          "lane": 0
        },
        {
          "assert": "laneEquals",
          "eventId": "b",
          "lane": 1
        },
        {
          "assert": "laneEquals",
          "eventId": "c",
          "lane": 2
        },
        {
          "assert": "laneConstantOverWholeEvent",
          "eventIds": [
            "a",
            "b",
            "c"
          ]
        },
        {
          "assert": "maxTemporalConcurrencyEquals",
          "value": 2
        }
      ],
      "notes": [
        "Lane 0 means the smallest distance from the axis, independently of axisPosition.",
        "Within the same category, A is longer than B; B has category priority over C.",
        "Choose collision spacing so that only the described temporal overlaps are relevant."
      ]
    },
