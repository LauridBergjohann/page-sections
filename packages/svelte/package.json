{
  "name": "@page-sections/svelte",
  "version": "0.6.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "SSR-first Svelte 5 pages, content grids, sections and navigation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LauridBergjohann/page-sections.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "svelte": "./dist/atoms/index.js",
      "default": "./dist/atoms/index.js"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "svelte": "./dist/molecules/index.js",
      "default": "./dist/molecules/index.js"
    },
    "./organisms": {
      "types": "./dist/organisms/index.d.ts",
      "svelte": "./dist/organisms/index.js",
      "default": "./dist/organisms/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "svelte": "./dist/layouts/index.js",
      "default": "./dist/layouts/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@page-sections/core": "0.6.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.56.4",
    "shiki": "^3.0.0 || ^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  }
}
