{
  "name": "page-sections", "private": true, "version": "0.0.0", "type": "module", "license": "MPL-2.0",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "layout:generate": "node scripts/generate-layout-css.mjs",
    "check:layout": "node scripts/generate-layout-css.mjs --check",
    "build": "npm run build -w @page-sections/core && npm run build -w @page-sections/svelte",
    "check": "npm run build && svelte-check --tsconfig tsconfig.json",
    "test": "vitest run",
    "build:demo": "npm run build && npm run build -w @page-sections/demo",
    "demo": "npm run build:demo && npm run preview -w @page-sections/demo",
    "test:e2e": "playwright test",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify": "npm run check:layout && npm run check && npm test && npm run verify:packages",
    "changeset": "changeset",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release:publish": "node scripts/publish-release.mjs",
    "verify:published": "node scripts/verify-packages.mjs --published"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1", "@playwright/test": "^1.60.0", "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0", "@types/node": "^24", "svelte": "5.56.4",
    "svelte-check": "4.7.2", "typescript": "6.0.3", "vite": "8.1.4", "vitest": "^4.1.8"
  }
}
